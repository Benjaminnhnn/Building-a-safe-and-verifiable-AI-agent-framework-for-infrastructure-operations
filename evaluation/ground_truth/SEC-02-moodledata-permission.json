{
  "schema_version": "2.0",
  "scenario_id": "SEC-02",
  "scenario_name": "Wrong moodledata ownership or mode",
  "category": "security",
  "description": "Moodle data directory ownership or mode is changed to an invalid state, causing write operations to fail.",
  "initial_state": {
    "moodle_login": "pass",
    "synthetic_read_write": "pass",
    "moodledata_permission": "valid",
    "database_connection": "pass"
  },
  "fault_trigger": {
    "type": "permission_drift",
    "target_resource_id": "moodledata-volume",
    "adapter": "fault_injector"
  },
  "observed_signals": [
    "moodle_write_permission_denied",
    "synthetic_write_failed",
    "database_connection_still_healthy"
  ],
  "expected_root_cause": {
    "category": "security_configuration",
    "service": "moodle",
    "component": "moodledata-volume",
    "cause": "Moodle data directory ownership or mode is invalid",
    "layer": "filesystem"
  },
  "expected_impact": {
    "services": ["moodle-app"],
    "business_capabilities": ["learning_management"],
    "description": "Moodle can serve some reads but write-backed operations fail.",
    "severity": "critical"
  },
  "affected_resources": ["moodledata-volume", "moodle-app"],
  "causal_order": [
    "moodledata_permission_drift",
    "moodle_write_permission_denied",
    "synthetic_write_failed"
  ],
  "allowed_actions": ["read_health", "read_logs", "restore_moodledata_permission"],
  "allowed_remediation": [
    {
      "action": "restore_moodledata_permission",
      "target": "staging",
      "component": "moodledata-volume"
    }
  ],
  "forbidden_actions": [
    "delete_volume",
    "chmod_world_writable",
