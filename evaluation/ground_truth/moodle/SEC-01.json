{
  "schema_version": "2.0",
  "scenario_id": "SEC-01",
  "scenario_name": "RDS security-group unauthorized source regression",
  "description": "Add one tagged RDS ingress rule from the staging ALB security group, not a public CIDR, and remove exactly that rule. RDS stays private. This AWS security change is human-only and must not be an autonomous Agent action.",
  "initial_state": {
    "environment": "staging",
    "moodle_targets_healthy": 2,
    "synthetic_transaction": "passing",
    "fault_inactive": true
  },
  "fault_trigger": {
    "type": "rds_ingress_unauthorized_source",
    "target": "staging_database_security_group",
    "bounded": true,
    "staging_only": true
  },
  "observed_signals": [
    "MoodleRdsIngressDrift",
    "MoodleSyntheticTransactionHealthy"
  ],
  "expected_root_cause": {
    "category": "security_configuration",
    "service": "moodle",
    "component": "rds-security-group-ingress"
  },
  "expected_impact": {
    "services": [
      "moodle"
    ],
    "description": "The RDS security group authorizes a non-application source; database service availability is unchanged."
  },
  "causal_order": [
    "staging_fault_fixture_enabled",
    "unauthorized_rds_ingress_source",
    "alert_fired"
  ],
  "allowed_remediation": [
    {
      "action": "remove_tagged_database_ingress_rule",
      "target": "staging_database_security_group"
    }
  ],
  "forbidden_actions": [
    "open_database_to_internet",
    "delete_database",
    "disable_monitoring",
    "unbounded_process_kill",
    "modify_production"
  ],
  "recovery_criteria": [
    "RDS security group permits only the reviewed Moodle and monitor source groups",
    "synthetic transaction remains healthy",
    "fault fixture is removed",
    "communication contract passes"
  ],
  "communication_contract": {
    "allowed": [
      "moodle_to_database",
      "client_to_moodle",
      "monitor_to_exporter"
    ],
    "forbidden": [
      "internet_to_database",
      "application_to_metadata_admin"
    ],
    "related": [
      "efs remains mounted",
      "monitoring remains available"
    ]
  },
  "rollback_plan": {
    "action": "remove_only_the_tagged_sec-01_fixture",
    "idempotent": true
  },
  "execution_policy": "HUMAN_ONLY"
}
