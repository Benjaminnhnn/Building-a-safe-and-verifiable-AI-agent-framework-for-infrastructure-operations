{
  "schema_version": "2.0",
  "scenario_id": "NET-02",
  "scenario_name": "Scoped Moodle-to-database port block",
  "description": "Reject only staging Moodle egress to the database port and remove only the tagged test rule.",
  "initial_state": {
    "environment": "staging",
    "moodle_targets_healthy": 2,
    "synthetic_transaction": "passing",
    "fault_inactive": true
  },
  "fault_trigger": {
    "type": "scoped_port_block",
    "target": "staging_moodle_nodes",
    "bounded": true,
    "staging_only": true
  },
  "observed_signals": [
    "MoodleDatabasePortBlocked",
    "MoodleSyntheticTransactionFailed"
  ],
  "expected_root_cause": {
    "category": "network_connectivity",
    "service": "moodle",
    "component": "moodle-to-postgresql-port"
  },
  "expected_impact": {
    "services": [
      "moodle"
    ],
    "description": "Reject only staging Moodle egress to the database port and remove only the tagged test rule."
  },
  "causal_order": [
    "staging_fault_fixture_enabled",
    "scoped_port_block",
    "alert_fired"
  ],
  "allowed_remediation": [
    {
      "action": "remove_scoped_moodle_db_port_reject",
      "target": "staging_moodle_nodes"
    }
  ],
  "forbidden_actions": [
    "open_database_to_internet",
    "delete_database",
    "disable_monitoring",
    "unbounded_process_kill",
    "modify_production"
  ],
  "recovery_criteria": [
    "synthetic transaction passes",
    "fault fixture is removed",
    "communication contract passes"
  ],
  "communication_contract": {
    "allowed": [
      "moodle_to_database",
      "client_to_moodle",
      "monitor_to_exporter"
    ],
    "forbidden": [
      "internet_to_database",
      "application_to_metadata_admin"
    ],
    "related": [
      "efs remains mounted",
      "monitoring remains available"
    ]
  },
  "rollback_plan": {
    "action": "remove_only_the_tagged_net-02_fixture",
    "idempotent": true
  }
