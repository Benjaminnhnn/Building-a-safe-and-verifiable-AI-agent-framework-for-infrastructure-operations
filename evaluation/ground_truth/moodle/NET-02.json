{
  "schema_version": "2.0",
  "scenario_id": "NET-02",
  "scenario_name": "Scoped Moodle-to-database port block",
  "description": "Reject only moodle-app-b web-container egress to the resolved RDS address on TCP 5432. Do not touch host SSH, monitor-to-RDS probes, EFS or moodle-app-a.",
  "initial_state": {
    "environment": "staging",
    "moodle_targets_healthy": 2,
    "synthetic_transaction": "passing",
    "fault_inactive": true
  },
  "fault_trigger": {
    "type": "scoped_port_block",
    "target": "moodle-app-b",
    "bounded": true,
    "staging_only": true
  },
  "observed_signals": [
    "MoodleNodeRdsTcpFailed",
    "MoodleRdsTcpProbeHealthy"
  ],
  "expected_root_cause": {
    "category": "network_connectivity",
    "service": "moodle",
    "component": "moodle-to-postgresql-port"
  },
  "expected_impact": {
    "services": [
      "moodle"
    ],
    "description": "Moodle app-b cannot reach RDS on TCP 5432; moodle-app-a and monitor direct RDS probe remain healthy."
  },
  "causal_order": [
    "staging_fault_fixture_enabled",
    "scoped_port_block",
    "alert_fired"
  ],
  "allowed_remediation": [
    {
      "action": "remove_scoped_moodle_db_port_reject",
      "target": "moodle-app-b"
    }
  ],
  "forbidden_actions": [
    "open_database_to_internet",
    "delete_database",
    "disable_monitoring",
    "unbounded_process_kill",
    "modify_production"
  ],
  "recovery_criteria": [
    "tagged DOCKER-USER reject rule is absent on moodle-app-b",
    "moodle-app-b reaches RDS on TCP 5432",
    "synthetic transaction remains healthy",
    "fault fixture is removed",
    "communication contract passes"
  ],
  "communication_contract": {
    "allowed": [
      "moodle_to_database",
      "client_to_moodle",
      "monitor_to_exporter"
    ],
    "forbidden": [
      "internet_to_database",
      "application_to_metadata_admin"
    ],
    "related": [
      "efs remains mounted",
      "monitoring remains available"
    ]
  },
  "rollback_plan": {
    "action": "remove_only_the_tagged_net-02_fixture",
    "idempotent": true
  }
}
