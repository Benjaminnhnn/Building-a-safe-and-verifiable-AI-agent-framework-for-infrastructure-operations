{
  "schema_version": "2.0",
  "scenario_id": "NET-03",
  "scenario_name": "Moodle-to-database latency and packet loss",
  "description": "Apply a bounded tc netem delay/loss profile only inside the moodle-app-b web container network namespace. Host eth0 and SSH remain untouched; reset removes only the recorded netem qdisc.",
  "initial_state": {
    "environment": "staging",
    "moodle_targets_healthy": 2,
    "synthetic_transaction": "passing",
    "fault_inactive": true
  },
  "fault_trigger": {
    "type": "latency_and_loss",
    "target": "moodle-app-b",
    "bounded": true,
    "staging_only": true
  },
  "observed_signals": [
    "MoodleNodeRdsTcpLatencyHigh",
    "MoodleSyntheticTransactionHealthy"
  ],
  "expected_root_cause": {
    "category": "network_quality",
    "service": "moodle",
    "component": "moodle-to-postgresql-link"
  },
  "expected_impact": {
    "services": [
      "moodle"
    ],
    "description": "Only moodle-app-b web-container egress becomes slow/lossy; host SSH, EFS and the other Moodle node remain healthy."
  },
  "causal_order": [
    "staging_fault_fixture_enabled",
    "latency_and_loss",
    "alert_fired"
  ],
  "allowed_remediation": [
    {
      "action": "remove_scoped_netem_profile",
      "target": "moodle-app-b"
    }
  ],
  "forbidden_actions": [
    "open_database_to_internet",
    "delete_database",
    "disable_monitoring",
    "unbounded_process_kill",
    "modify_production"
  ],
  "recovery_criteria": [
    "recorded container netem qdisc is absent",
    "moodle-app-b to RDS latency returns to baseline range",
    "synthetic transaction remains healthy",
    "fault fixture is removed",
    "communication contract passes"
  ],
  "communication_contract": {
    "allowed": [
      "moodle_to_database",
      "client_to_moodle",
      "monitor_to_exporter"
    ],
    "forbidden": [
      "internet_to_database",
      "application_to_metadata_admin"
    ],
    "related": [
      "efs remains mounted",
      "monitoring remains available"
    ]
  },
  "rollback_plan": {
    "action": "remove_only_the_tagged_net-03_fixture",
    "idempotent": true
  }
}
