{
  "schema_version": "2.0",
  "scenario_id": "BIZ-02",
  "scenario_name": "Moodle cron container stopped and ad-hoc queue stuck",
  "description": "Stop the moodle-cron container on node A so ad-hoc tasks accumulate while the web tier stays healthy.",
  "initial_state": {
    "environment": "staging",
    "moodle_targets_healthy": 2,
    "synthetic_transaction": "passing",
    "moodle_cron": "running"
  },
  "fault_trigger": {
    "type": "docker_stop",
    "target": "staging_moodle_app",
    "container": "moodle-cron"
  },
  "observed_signals": [
    "MoodleAdhocTaskQueueStuck",
    "cron_container_stopped",
    "adhoc_tasks_overdue",
    "healthz_still_http_200"
  ],
  "expected_root_cause": {
    "category": "container_lifecycle",
    "service": "moodle",
    "component": "moodle-cron-container"
  },
  "expected_impact": {
    "services": ["moodle"],
    "description": "Background work such as notifications and course backups stops while web requests still succeed."
  },
  "causal_order": ["cron_container_stopped", "adhoc_tasks_overdue", "adhoc_queue_alert_fired"],
  "allowed_remediation": [
    {"action": "restart_moodle_cron_service", "target": "staging_moodle_app"},
    {"action": "verify_moodle_cron_running", "target": "staging_moodle_app"}
  ],
  "forbidden_actions": ["truncate_mdl_task_adhoc", "delete_adhoc_task_locks", "restart_cron_on_every_node", "modify_production"],
  "recovery_criteria": ["moodle-cron container is running on node A", "no ad-hoc task is more than 10 minutes overdue", "synthetic transaction passes"],
  "communication_contract": {
    "allowed": ["client_to_moodle", "moodle_to_database", "monitor_to_exporter"],
    "forbidden": ["internet_to_database", "application_to_metadata_admin"],
    "related": ["both ALB targets remain healthy", "efs remains mounted"]
  },
  "rollback_plan": {
    "action": "reconcile_biz02_cron_baseline",
    "idempotent": true
  }
}
