{
  "schema_version": "2.0",
  "scenario_id": "CON-02",
  "scenario_name": "Moodle Apache router configuration drift",
  "description": "Disable the Moodle Apache FallbackResource configuration inside the web container on moodle-app-b only. ALB and the other node remain healthy; routed paths on the affected node fail while healthz and direct PHP files may pass.",
  "initial_state": {
    "environment": "staging",
    "moodle_targets_healthy": 2,
    "synthetic_transaction": "passing",
    "fault_inactive": true
  },
  "fault_trigger": {
    "type": "apache_router_disabled",
    "target": "moodle-app-b",
    "bounded": true,
    "staging_only": true
  },
  "observed_signals": [
    "MoodleNodeRouterFallbackFailed",
    "MoodleApacheRouterMissing"
  ],
  "expected_root_cause": {
    "category": "container_dependency",
    "service": "moodle",
    "component": "moodle-apache-router"
  },
  "expected_impact": {
    "services": [
      "moodle"
    ],
    "description": "A path requiring Moodle's FallbackResource is handled by Apache rather than Moodle on moodle-app-b; the ALB and moodle-app-a remain available."
  },
  "causal_order": [
    "staging_fault_fixture_enabled",
    "apache_router_disabled_on_moodle_app_b",
    "alert_fired"
  ],
  "allowed_remediation": [
    {
      "action": "restore_moodle_apache_router",
      "target": "moodle-app-b"
    }
  ],
  "forbidden_actions": [
    "open_database_to_internet",
    "delete_database",
    "disable_monitoring",
    "unbounded_process_kill",
    "modify_production"
  ],
  "recovery_criteria": [
    "node-local Moodle router fallback probe passes on moodle-app-b",
    "both ALB targets healthy",
    "fault fixture is removed",
    "communication contract passes"
  ],
  "communication_contract": {
    "allowed": [
      "moodle_to_database",
      "client_to_moodle",
      "monitor_to_exporter"
    ],
    "forbidden": [
      "internet_to_database",
      "application_to_metadata_admin"
    ],
    "related": [
      "efs remains mounted",
      "monitoring remains available"
    ]
  },
  "rollback_plan": {
    "action": "remove_only_the_tagged_con-02_fixture",
    "idempotent": true
  }
}
