{
  "schema_version": "2.0",
  "scenario_id": "RES-03",
  "scenario_name": "Moodle node isolated scratch filesystem pressure",
  "description": "Fill only a bounded test scratch filesystem on moodle-app-b. EFS is elastic and is not filled or modified for this scenario; Moodle remains available on both nodes.",
  "initial_state": {
    "environment": "staging",
    "moodle_targets_healthy": 2,
    "synthetic_transaction": "passing",
    "fault_inactive": true
  },
  "fault_trigger": {
    "type": "disk_pressure",
    "target": "moodle-app-b",
    "bounded": true,
    "staging_only": true
  },
  "observed_signals": [
    "MoodleScratchEnospc",
    "MoodleSyntheticTransactionHealthy"
  ],
  "expected_root_cause": {
    "category": "resource_exhaustion",
    "service": "moodle",
    "component": "moodle-app-b-scratch-filesystem"
  },
  "expected_impact": {
    "services": [
      "moodle"
    ],
    "description": "The isolated scratch probe reports ENOSPC on moodle-app-b; EFS, Moodle and the other node remain healthy."
  },
  "causal_order": [
    "staging_fault_fixture_enabled",
    "disk_pressure",
    "alert_fired"
  ],
  "allowed_remediation": [
    {
      "action": "remove_named_disk_fixture",
      "target": "moodle-app-b"
    }
  ],
  "forbidden_actions": [
    "open_database_to_internet",
    "delete_database",
    "disable_monitoring",
    "unbounded_process_kill",
    "modify_production"
  ],
  "recovery_criteria": [
    "isolated scratch mountpoint is absent and its ENOSPC metric clears after fixture removal",
    "synthetic transaction remains healthy",
    "fault fixture is removed",
    "communication contract passes"
  ],
  "communication_contract": {
    "allowed": [
      "moodle_to_database",
      "client_to_moodle",
      "monitor_to_exporter"
    ],
    "forbidden": [
      "internet_to_database",
      "application_to_metadata_admin"
    ],
    "related": [
      "efs remains mounted",
      "monitoring remains available"
    ]
  },
  "rollback_plan": {
    "action": "remove_only_the_tagged_res-03_fixture",
    "idempotent": true
  }
}
