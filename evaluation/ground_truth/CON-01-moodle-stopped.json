{
  "schema_version": "2.0",
  "scenario_id": "CON-01",
  "scenario_name": "Moodle container stopped",
  "category": "container",
  "description": "Moodle application container is stopped while PostgreSQL and monitoring remain healthy.",

  "initial_state": {
    "moodle_login": "pass",
    "synthetic_read_write": "pass",
    "database_connection": "pass",
    "monitoring_scrape": "pass"
