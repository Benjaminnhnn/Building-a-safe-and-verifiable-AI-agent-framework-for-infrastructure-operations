  "fault_trigger": {
    "type": "container_stop",
    "target_resource_id": "moodle-app",
    "adapter": "docker"
  },
  "observed_signals": [
    "moodle_endpoint_down",
    "container_state_exited",
    "postgres_exporter_still_up"
  ],
  "expected_root_cause": {
    "category": "container",
    "service": "moodle",
    "component": "moodle-app",
    "cause": "Moodle container stopped",
    "layer": "application"
  },
  "expected_impact": {
    "services": ["moodle-app"],
    "business_capabilities": ["learning_management"],
    "description": "Moodle web endpoint is unavailable.",
    "severity": "critical"
  },
  "affected_resources": ["moodle-app"],
  "causal_order": [
