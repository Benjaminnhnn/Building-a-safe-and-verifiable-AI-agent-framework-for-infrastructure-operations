<mxCell id="n29" value="Scoped remediation and independent probes return to the application over internal adapter connections." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="75" y="680" width="1240" height="25" as="geometry"/></mxCell>
<mxCell id="n30" value="&lt;b&gt;CONTROL-PLANE DATA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Evidence Store · incident state · resource graph · RAG · policy catalog · audit log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F7;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="775" width="665" height="85" as="geometry"/></mxCell>
<mxCell id="n31" value="&lt;b&gt;RESEARCH &amp; GENERALIZATION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;15 Moodle + 3 ERPNext scenarios · Manual / Ansible / AI&lt;br&gt;Fault injection + reset · offline ground truth scoring · safety / verifier ablations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F7;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="735" y="775" width="665" height="85" as="geometry"/></mxCell>
<mxCell id="n32" value="Region, CIDR, subnet placement and host count are deployment decisions. Diagram 02 details approvals, execution and failure paths." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="1350" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="lifecycle" name="02 - Incident Lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="n2" value="INCIDENT LIFECYCLE  /  CONTROLLED RECOVERY" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=28;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1330" height="45" as="geometry"/></mxCell>
<mxCell id="n3" value="Main path left → right. Supporting records and exception paths sit directly below each stage." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=15;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1330" height="25" as="geometry"/></mxCell>
<mxCell id="n4" value="&lt;b&gt;1  OBSERVE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Alertmanager webhook&lt;br&gt;Normalize + validate&lt;br&gt;Queue + correlate + deduplicate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3E8;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="245" height="145" as="geometry"/></mxCell>
<mxCell id="n5" value="&lt;b&gt;2  DIAGNOSE / PLAN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Diagnosis: evidence + hypotheses&lt;br&gt;Planner: typed action + target&lt;br&gt;Preconditions + rollback plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAFB;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="320" y="155" width="245" height="145" as="geometry"/></mxCell>
<mxCell id="n6" value="&lt;b&gt;3  SAFETY GATE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Evidence + permission + risk&lt;br&gt;ALLOW / REQUIRE_APPROVAL&lt;br&gt;DENY unsafe actions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D9;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="155" width="245" height="145" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b&gt;4  EXECUTE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Allowlisted Docker / Ansible&lt;br&gt;Snapshot + timeout + idempotency&lt;br&gt;Record execution result&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D9;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="880" y="155" width="245" height="145" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;5  VERIFY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Independent read-only identity&lt;br&gt;Fresh health + contract probes&lt;br&gt;Stability window&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F3F1;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1160" y="155" width="245" height="145" as="geometry"/></mxCell>
<mxCell id="e9" value="Evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526779;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e10" value="Plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526779;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="n5" target="n6" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e11" value="Allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526779;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="n6" target="n7" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e12" value="Result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526779;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="n7" target="n8" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="n13" value="&lt;b&gt;INCIDENT / EVIDENCE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Source + time + hash + redaction&lt;br&gt;Resource / incident / action IDs&lt;br&gt;Append-only audit events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="245" height="130" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;ORCHESTRATOR / RAG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Sequential stages + checkpoints&lt;br&gt;Bounded retry; no duplicate action&lt;br&gt;Runbooks + dependency graph&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAFB;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="320" y="410" width="245" height="130" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;APPROVAL / DENIAL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Authenticate operator&lt;br&gt;Action hash + TTL + policy recheck&lt;br&gt;Reject / expire → no execution&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D9;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="410" width="245" height="130" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;EXECUTION FAILURE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Reversible + policy-approved?&lt;br&gt;Yes → conditional rollback&lt;br&gt;No → escalate for intervention&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D9;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="880" y="410" width="245" height="130" as="geometry"/></mxCell>
<mxCell id="n17" value="&lt;b&gt;VERDICT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Pass → RESOLVED&lt;br&gt;Fail / timeout → UNRESOLVED&lt;br&gt;Record probes and escalate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F3F1;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1160" y="410" width="245" height="130" as="geometry"/></mxCell>
<mxCell id="e18" value="Persist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526779;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" source="n4" target="n13" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e19" value="Context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526779;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" source="n5" target="n14" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e20" value="Approval / deny" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526779;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" source="n6" target="n15" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e21" value="Failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526779;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" source="n7" target="n16" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e22" value="Decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526779;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" source="n8" target="n17" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="n23" value="&lt;b&gt;SAFETY BOUNDARIES&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Planner has no execution credential. Safety Gate decides but does not execute.&lt;br&gt;Executor uses scoped adapters; Verifier uses a separate read-only identity.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F7;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="665" height="100" as="geometry"/></mxCell>
<mxCell id="n24" value="&lt;b&gt;COMMUNICATION CONTRACT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Allowed connections work · forbidden access stays blocked · related services remain healthy.&lt;br&gt;Successful process health alone is insufficient to declare recovery.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F7;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="735" y="620" width="670" height="100" as="geometry"/></mxCell>
<mxCell id="n25" value="&lt;b&gt;RECORDED RUN OUTPUTS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Evidence + diagnosis + actions + verdicts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="785" width="365" height="75" as="geometry"/></mxCell>
<mxCell id="n26" value="&lt;b&gt;OFFLINE SCORER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Ground truth + safety / verifier ablations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAFB;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="785" width="365" height="75" as="geometry"/></mxCell>
<mxCell id="n27" value="&lt;b&gt;THESIS METRICS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;RCA accuracy / recovery / false recovery&lt;br&gt;Unsafe actions / audit / latency / cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F3F1;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1020" y="785" width="385" height="75" as="geometry"/></mxCell>
<mxCell id="e28" value="Export" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526779;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" source="n25" target="n26" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e29" value="Compare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526779;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" source="n26" target="n27" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="n30" value="Ground truth is excluded from inference. Approved actions are revalidated; rollback returns to independent verification." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1360" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
