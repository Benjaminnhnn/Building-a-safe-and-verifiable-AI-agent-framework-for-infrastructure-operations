<mxCell id="n20" value="&lt;b&gt;AI Agent System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;API + queue + sequential Orchestrator&lt;br&gt;Observer / Diagnosis / Planner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAFB;strokeColor=#CBD5E1;fontColor=#232F3E;fontSize=16;spacing=10;" vertex="1" parent="n7"><mxGeometry x="20" y="135" width="400" height="75" as="geometry"/></mxCell>
