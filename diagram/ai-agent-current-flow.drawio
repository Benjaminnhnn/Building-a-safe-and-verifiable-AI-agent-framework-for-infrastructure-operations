        <mxCell id="approvals" value="Hai người khác nhau ký Ed25519&lt;br&gt;Gate approval + Executor approval còn hạn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6DA;strokeColor=#C99A24;strokeWidth=2;fontColor=#57400B;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="755" y="1241" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="gate" value="Operator gọi &lt;b&gt;execute&lt;/b&gt; → Safety Gate&lt;br&gt;kiểm tra lại request, scope, allowlist, chữ ký, kill switch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CE8627;strokeWidth=2;fontColor=#593B16;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="1380" width="570" height="72" as="geometry"/></mxCell>
        <mxCell id="executor" value="Safe Executor thực hiện đúng action được duyệt&lt;br&gt;ghi receipt, audit chain; thất bại → escalation/rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CE8627;strokeWidth=2;fontColor=#593B16;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="1558" width="570" height="72" as="geometry"/></mxCell>
        <mxCell id="verify" value="Independent Verifier: ≥120 giây, ≥5 mẫu&lt;br&gt;allowed / forbidden / related probes + receipt audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B8B57;strokeWidth=2;fontColor=#225639;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="1666" width="570" height="72" as="geometry"/></mxCell>
        <mxCell id="verdict" value="Probes đạt + attestation&lt;br&gt;Ed25519 hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#2B8B57;strokeWidth=2;fontColor=#225639;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="755" y="1776" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="resolved" value="Agent chấp nhận chữ ký Verifier&lt;br&gt;ghi &lt;b&gt;RESOLVED&lt;/b&gt; vào runtime audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF2E5;strokeColor=#2B8B57;strokeWidth=2;fontColor=#1F603A;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="1920" width="570" height="72" as="geometry"/></mxCell>

        <mxCell id="resolved-alert" value="Alertmanager gửi &lt;b&gt;resolved&lt;/b&gt;:&lt;br&gt;xóa cooldown + báo Telegram&lt;br&gt;chưa đồng nghĩa incident RESOLVED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#9DAABA;fontColor=#42566E;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="215" width="400" height="84" as="geometry"/></mxCell>
        <mxCell id="out-scope" value="Khác đường investigate hiện tại:&lt;br&gt;shadow chỉ quan sát; disabled/live escalated;&lt;br&gt;non-Moodle bỏ qua, không dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#D47878;fontColor=#8A3333;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1325" y="552" width="415" height="96" as="geometry"/></mxCell>
        <mxCell id="evidence-stop" value="Thiếu / cũ / mâu thuẫn evidence:&lt;br&gt;awaiting_evidence hoặc bàn giao admin&lt;br&gt;không tạo quyền thực thi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#D47878;fontColor=#8A3333;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1325" y="785" width="415" height="84" as="geometry"/></mxCell>
        <mxCell id="human-only" value="HUMAN_ONLY / action không allowlist:&lt;br&gt;Telegram + runbook → admin xử lý&lt;br&gt;Agent không sửa, không tự RESOLVED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#D47878;fontColor=#8A3333;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1325" y="909" width="415" height="90" as="geometry"/></mxCell>
        <mxCell id="approval-stop" value="Thiếu / sai / hết hạn chữ ký, Gate DENY:&lt;br&gt;awaiting_approval hoặc từ chối&lt;br&gt;không gọi Executor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#D47878;fontColor=#8A3333;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1325" y="1248" width="415" height="85" as="geometry"/></mxCell>
        <mxCell id="execution-stop" value="Executor lỗi / trạng thái không rõ:&lt;br&gt;audit + escalation / rollback&lt;br&gt;không đánh dấu phục hồi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#D47878;fontColor=#8A3333;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1325" y="1547" width="415" height="90" as="geometry"/></mxCell>
        <mxCell id="verifier-stop" value="Probe hoặc chữ ký không đạt:&lt;br&gt;giữ chưa RESOLVED, báo admin&lt;br&gt;điều tra / rollback khi cần" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCECEC;strokeColor=#D47878;fontColor=#8A3333;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1325" y="1786" width="415" height="90" as="geometry"/></mxCell>
        <mxCell id="rag-note" value="&lt;b&gt;Nguồn tri thức&lt;/b&gt;&lt;br&gt;Runbook RAG + incident memory hỗ trợ báo cáo; nội dung truy xuất không cấp quyền action. Gemini chỉ review feedback admin khi được yêu cầu, không nằm trong alert path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F2FC;strokeColor=#A891CB;fontColor=#594978;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="65" y="742" width="410" height="158" as="geometry"/></mxCell>
        <mxCell id="boundary-note" value="&lt;b&gt;Ranh giới vận hành&lt;/b&gt;&lt;br&gt;Alert chỉ chạy điều tra. Hành động live đi qua operator handoff riêng. Ground truth chỉ dùng để chấm điểm offline, không chọn action hay target." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F2FC;strokeColor=#A891CB;fontColor=#594978;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="65" y="1070" width="410" height="143" as="geometry"/></mxCell>

