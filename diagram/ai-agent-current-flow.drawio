        <mxCell id="candidate" value="Lưu remediation candidate + audit hash&lt;br&gt;Gửi Telegram: kết luận, phạm vi, việc admin cần làm&lt;br&gt;&lt;b&gt;execution_permitted = false&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9EF;strokeColor=#CE8627;strokeWidth=2;fontColor=#593B16;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="1020" width="570" height="82" as="geometry"/></mxCell>
