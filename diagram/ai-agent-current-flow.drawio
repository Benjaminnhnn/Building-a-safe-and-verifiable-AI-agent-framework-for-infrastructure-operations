        <mxCell id="alert" value="Prometheus / Blackbox / exporters&lt;br&gt;&lt;b&gt;Alertmanager: firing / resolved&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3176B7;strokeWidth=2;fontColor=#172B4D;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="215" width="570" height="66" as="geometry"/></mxCell>
        <mxCell id="webhook" value="FastAPI &lt;b&gt;/webhook&lt;/b&gt; → Celery worker&lt;br&gt;nhận payload Alertmanager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3176B7;strokeWidth=2;fontColor=#172B4D;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="319" width="570" height="66" as="geometry"/></mxCell>
