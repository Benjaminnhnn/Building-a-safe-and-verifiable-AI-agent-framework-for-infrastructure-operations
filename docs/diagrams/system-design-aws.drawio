<mxfile host="app.diagrams.net" agent="thesis-generator" version="24.7.17"><diagram id="page1" name="1. AWS deployment"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2320" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Safe &amp;amp; Verifiable AI Agent Framework for Infrastructure Operations — AWS deployment (staging)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c2" value="Source of truth: terraform/*.tf, ansible/playbooks/*.yml, release/moodle/docker-compose.yml, .github/workflows. Moodle is the primary evaluation environment; ERPNext (optional, enable_erpnext) checks generalization." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6C86;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1600" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Students / Teachers&lt;/b&gt;&lt;br&gt;Moodle users" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;fontFamily=Helvetica;fillColor=#232F3E;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="100" y="120" width="56" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Operators&lt;/b&gt;&lt;br&gt;2 approvers, separate&lt;br&gt;Ed25519 keys" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;fontFamily=Helvetica;fillColor=#232F3E;shape=mxgraph.aws4.user;" vertex="1" pare