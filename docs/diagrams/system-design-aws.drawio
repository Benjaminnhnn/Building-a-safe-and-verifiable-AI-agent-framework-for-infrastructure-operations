fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="228" y="1020" width="24" height="24" as="geometry"/></mxCell><mxCell id="c94" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="286" width="24" height="24" as="geometry"/></mxCell><mxCell id="c95" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="683" y="1413" width="24" height="24" as="geometry"/></mxCell><mxCell id="c96" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="843" y="1413" width="24" height="24" as="geometry"/></mxCell><mxCell id="c97" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="597" width="24" height="24" as="geometry"/></mxCell><mxCell id="c98" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1410" y="597" width="24" height="24" as="geometry"/></mxCell><mxCell id="c99" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="883" y="1413" width="24" height="24" as="geometry"/></mxCell><mxCell id="c100" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="968" y="1200" width="24" height="24" as="geometry"/></mxCell><mxCell id="c101" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="228" y="500" width="24" height="24" as="geometry"/></mxCell><mxCell id="c102" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="658" y="1413" width="24" height="24" as="geometry"/></mxCell><mxCell id="c103" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="497" width="24" height="24" as="geometry"/></mxCell><mxCell id="c104" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1410" y="497" width="24" height="24" as="geometry"/></mxCell><mxCell id="c105" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="713" y="1350" width="24" height="24" as="geometry"/></mxCell><mxCell id="c106" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2085" y="553" width="24" height="24" as="geometry"/></mxCell><mxCell id="c107" value="&lt;b&gt;Flow legend&lt;/b&gt; (numbered edge labels and black badges)&lt;br&gt;① Users reach Moodle through the IGW and ALB (HTTPS with ACM when configured).&lt;br&gt;② ALB forwards to both app nodes on :8080; one healthy target is kept during rolling deploys.&lt;br&gt;③ Moodle uses RDS PostgreSQL (TLS) and shared moodledata on EFS through per-AZ mount targets.&lt;br&gt;④ Prometheus scrapes node-exporter, cAdvisor and node probes; Blackbox probes the ALB and RDS path.&lt;br&gt;⑤ Alertmanager posts to the agent webhook; the Celery worker runs Observer → Diagnosis → Planner (read-only).&lt;br&gt;⑥ Optional bounded Gemini call for evidence-cited diagnosis; a deterministic citation validator must accept it.&lt;br&gt;⑦ Operator report and feedback over Telegram.&lt;br&gt;⑧ Remediation needs two separate Ed25519 approvals bound to the plan hash, scope and expiry.&lt;br&gt;⑨ The Safety Gate re-checks, then the executor runs one allowlisted action via an SSH forced command.&lt;br&gt;⑩ The executor receipt goes to the Independent Verifier; only its signed attestation can mark the incident RESOLVED.&lt;br&gt;⑪ CI builds immutable images to GHCR; the self-hosted runner rolls node B then node A over SSH.&lt;br&gt;⑫ The RDS ingress audit uses the monitor IAM role (ec2:DescribeSecurityGroupRules only).&lt;br&gt;⑥ ⑦ leave through the monitor Elastic IP; app-node egress (GHCR pull, OIDC) uses the NAT gateways." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="290" y="1660" width="1100" height="240" as="geometry"/></mxCell><mxCell id="c108" value="&lt;b&gt;Line colours&lt;/b&gt;&lt;br&gt;&lt;font color='#232F3E'&gt;■&lt;/font&gt; user traffic &amp;nbsp; &lt;font color='#C925D1'&gt;■&lt;/font&gt; data &amp;nbsp; &lt;font color='#E7157B'&gt;■&lt;/font&gt; monitoring &amp;nbsp; &lt;font color='#147EBA'&gt;■&lt;/font&gt; AI agent&lt;br&gt;&lt;font color='#DD344C'&gt;■&lt;/font&gt; safety / approval (dashed) &amp;nbsp; &lt;font color='#7D8998'&gt;■&lt;/font&gt; CI/CD and egress (dashed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1410" y="1660" width="470" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2. AI agent framework"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="AI agent framework — six-layer logical architecture and incident lifecycle" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c2" value="Layers follow the thesis outline. Shared IDs: incident_id, evidence_id, action_id. Every stage writes a hash-chained StageAuditEvent (docs/RUNTIME_AGENT_ROLES.md)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6C86;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1600" height="22" as="geometry"/></mxCell><mxCell id="c3" value="1  Observation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#AAB7B8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><