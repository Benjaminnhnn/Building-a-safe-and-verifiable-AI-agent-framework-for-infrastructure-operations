# This is a non-secret template. Copy it to moodle-runtime.env on each EC2
# through the reviewed release procedure; do not commit the resulting file.
MOODLE_IMAGE=local/moodle:5.2.3
MOODLE_DATA_DIR=/mnt/efs/moodledata
MOODLE_DATA_ROOT=/var/moodledata
MOODLE_SECRETS_DIR=/opt/moodle/secrets
MOODLE_REVERSE_PROXY=false
MOODLE_DB_HOST=moodle-staging-postgres.example.ap-southeast-1.rds.amazonaws.com
MOODLE_DB_PORT=5432
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_app
MOODLE_WWWROOT=https://moodle.example.com
MOODLE_SSL_PROXY=true
MOODLE_SITE_FULLNAME=Moodle Staging
MOODLE_SITE_SHORTNAME=Moodle
MOODLE_SITE_SUMMARY=Infrastructure operations test environment
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_CRON_INTERVAL_SECONDS=60
