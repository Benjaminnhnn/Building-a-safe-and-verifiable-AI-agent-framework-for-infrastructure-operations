# ======================================
# Deployment Environment Template
# ======================================
# Copy this file to .env.staging or .env.production
# Update values with your actual credentials
# DO NOT commit .env files to git

# ======================================
# Docker Image Registry
# ======================================
# GitHub Container Registry owner/org
# Example: github-username or org-name
GHCR_OWNER=your-github-username-or-org

# Image tag (optional - can be overridden by deploy script)
# Examples: staging-latest, v1.0.0, production-abc123
IMAGE_TAG=staging-latest

# ======================================
# AI Agent Configuration
# ======================================
# Google Generative AI API key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Keep AI enrichment cheap and predictable during alert storms.
# Defaults are intentionally conservative: one model, one attempt, one tool call.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=
GEMINI_MAX_ATTEMPTS=1
GEMINI_MAX_REMOTE_CALLS=1
ALERT_AI_COOLDOWN_SECONDS=900
ALERT_DEDUP_ENABLED=true
ALERT_INGRESS_DEDUP_SECONDS=60
ALERT_BATCH_CONCURRENCY=4
CELERY_QUEUE_MAX_LENGTH=1000
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
REDIS_BROKER_MAXMEMORY=512mb
REDIS_CACHE_MAXMEMORY=256mb
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BASE_SECONDS=1

# Telegram integration (optional)
# Leave empty or remove if not using Telegram notifications
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Port for AI Agent (default 8000)
AI_AGENT_PORT=8000

# Public HTTPS URL for Telegram webhook registration.
# Leave empty if you only use outbound Telegram notifications.
# Example: https://aiops.example.com
AI_AGENT_PUBLIC_URL=

# GitHub webhook auto-discovery.
# GITHUB_WEBHOOK_SECRET must match the secret configured in GitHub Webhooks.
# GITHUB_DISCOVERY_TOKEN is optional for public repos, recommended for private repos/rate limits.
GITHUB_WEBHOOK_SECRET=
GITHUB_DISCOVERY_TOKEN=

# Shared persistent ChromaDB path used by the AI Agent and Celery worker.
VECTOR_DB_PATH=/app/vector_db
# Drop semantic retrieval results with a larger ChromaDB distance.
RAG_MAX_DISTANCE=1.2

# ======================================
# Unified AI Pipeline (Moodle Sprint 2+)
# ======================================
# Options: disabled | shadow | live
AIOPS_UNIFIED_CORE_MODE=disabled
AIOPS_EVIDENCE_DB=/app/aiops-evidence/evidence.sqlite3
AIOPS_EVIDENCE_DB_PATH=/app/data/evidence.db
# MOODLE_PIPELINE_EXECUTION_CONFIRM=staging
MOODLE_APPROVAL_HMAC_KEY=
MOODLE_APPROVER_IDS=
MOODLE_PUBLIC_URL=
MOODLE_DB_HOST=
MOODLE_DB_PORT=5432

# ======================================
# Prometheus Configuration (NEW)
# ======================================
# Prometheus API endpoint for automatic verification
# Used in Phase 9 to verify if alerts are resolved
# Local development: http://localhost:9090
# Release containers on the monitor host: http://host.docker.internal:9090
# Remote: http://prometheus.example.com:9090
PROMETHEUS_URL=http://host.docker.internal:9090

# ======================================
# Payment API Configuration
# ======================================
# Database connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://aiops_user:secure_pass@db-host:5432/aiops_db
DATABASE_URL=postgresql://aiops_user:aiops_pass@localhost:5432/aiops_db

# Frontend Nginx upstream to the core Payment API.
# CI/CD fills this per environment. Example: http://10.10.1.118:8080
PAYMENT_API_UPSTREAM=

# Production frontend listens behind Caddy on localhost.
FRONTEND_PROD_HOST_PORT=3000

# Secret key for Payment API
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me_to_a_strong_random_key

# Environment identifier (staging or production)
ENVIRONMENT=staging
